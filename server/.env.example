PORT=4000
NODE_ENV=development
# Local development: use the Vite origin for both values.
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production: set both values to the deployed frontend's HTTPS origin.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Configure production SMTP credentials in the hosting provider, not in source control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM="GCMS <gmc@gmail.com>"
DATABASE_URL=postgresql://postgres:password@localhost:5432/group_contributions
